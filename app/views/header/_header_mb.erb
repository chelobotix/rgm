<%= link_to root_path, class: "cursor-pointer" do %>
  <div class="flex items-center justify-center gap-2">
    <%= image_tag "rails-genius-logo.png", alt: "rails genius logo", class: "h-18 w-18" %>
    <p class="text-xl font-semibold text-gray-900">Rails Genius</p>
  </div>
<% end %>

<div class="flex items-center gap-4">
  <div class="text-gray-600">Search here</div>

  <div data-controller="menu" class="relative">
    <button class="p-2 text-gray-600 hover:text-gray-900" aria-label="Menu" data-action="click->menu#toggleMenu">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <div data-menu-target="menuMobile" class="fixed inset-0 z-40 hidden pointer-events-none">
      <div class="absolute inset-0 pointer-events-auto" data-action="click->menu#closeMenu"></div>
      <%= render "header/scroll_menu" %>
    </div>
  </div>
</div>
