
<%= link_to root_path, class: "cursor-pointer" do %>
  <div class="flex items-center justify-center gap-2">
    <%= image_tag "rails-genius-logo.png", alt: "rails genius logo", class: "h-18 w-18 dark:hidden" %>
    <%= image_tag "rails-genius-logo-dark.png", alt: "rails genius logo", class: "h-18 w-18 hidden dark:block" %>
    <p class="text-xl font-semibold text-gray-900 dark:text-white">Rails Genius</p>
  </div>
<% end %>

<div class="flex items-center gap-6">
  <%= render "theme_selector/theme_selector", { icon_color: "text-black", icon_color_dark: "text-white" } %>
</div>
