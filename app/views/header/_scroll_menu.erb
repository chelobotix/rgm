<div data-menu-target="sidebar" class="absolute top-0 right-0 h-screen w-80 bg-red-500 z-50 transform transition-transform duration-300 ease-in-out translate-x-full flex flex-col items-center gap-3 p-1 overflow-y-auto">
  <div class="self-end">
    <div class="rounded-full border-2 border-gray-300 text-white p-2 m-1 mb-2 cursor-pointer" data-action="click->menu#closeMenu">
      <i class="pi pi-times text-white"></i>
    </div>
  </div>

  <div class="w-full px-4">
    <ul class="flex flex-col gap-2">
      <li class="cursor-pointer p-2 hover:bg-red-600 rounded">
        <div class="flex items-center gap-2 text-white">
          <i class="pi pi-sun"></i>
          <span>Light</span>
        </div>
      </li>
      <li class="cursor-pointer p-2 hover:bg-red-600 rounded">
        <div class="flex items-center gap-2 text-white">
          <i class="pi pi-moon"></i>
          <span>Dark</span>
        </div>
      </li>
      <li class="cursor-pointer p-2 hover:bg-red-600 rounded">
        <div class="flex items-center gap-2 text-white">
          <i class="pi pi-desktop"></i>
          <span>System</span>
        </div>
      </li>
    </ul>
  </div>

  <div class="w-full px-4">
    <div class="text-gray-200">Languages</div>
  </div>

  <div class="w-full px-4">
    <div class="h-12 w-12 rounded-full bg-red-500 text-white flex items-center justify-center mr-2">
      user avatar
    </div>
  </div>

  <div class="w-full px-4 flex flex-col gap-2">
    <a href="/archive" class="ml-2 text-gray-200 text-base font-normal hover:text-white">
      <div class="flex gap-2 items-center">
        <i class="pi pi-address-book text-gray-200 font-normal"></i>
        Archive
      </div>
    </a>
    <a href="/about" class="ml-2 text-gray-200 text-base font-normal hover:text-white">
      <div class="flex gap-2 items-center">
        <i class="pi pi-address-book text-gray-200 font-normal"></i>
        About
      </div>
    </a>
  </div>

  <div class="w-full px-4">
    <div class="flex flex-col items-center gap-2">
      <p class="text-sm text-gray-200">Subscribe Today</p>
      <p class="text-lg text-gray-200 font-semibold text-center">Become a Rail Genius</p>
      <div class="flex w-full">
        <input type="text" placeholder="@email" class="px-3 py-2 border border-gray-300 rounded-l flex-1" />
        <button type="button" class="px-4 py-2 bg-yellow-500 text-white rounded-r">Subscribe</button>
      </div>
    </div>
  </div>

  <div class="mt-auto w-full px-4 pb-4">
    <div class="flex justify-center gap-5">
      <i class="pi pi-linkedin text-white" style="font-size: 1.3rem"></i>
      <i class="pi pi-github text-white" style="font-size: 1.3rem"></i>
      <i class="pi pi-envelope text-white" style="font-size: 1.3rem"></i>
    </div>
  </div>
</div>

<div class="hidden p-2 flex flex-col items-center gap-4 mb-1 bg-white rounded-lg shadow-lg">
  <div class="flex flex-col items-center justify-center gap-2">
    <div class="h-16 w-16 rounded-full bg-red-500 text-white flex items-center justify-center mr-2 text-xl font-bold">
      U
    </div>
    <span class="font-bold truncate text-gray-600">user email</span>
  </div>

  <div class="flex flex-col items-center">
    <span class="text-gray-500 block mb-5">Update Your Password</span>

    <form class="flex flex-col items-center gap-4">
      <div class="relative">
        <input type="password" id="newPassword" class="px-3 py-2 border border-gray-300 rounded" />
        <label for="newPassword" class="absolute left-3 -top-2 bg-white px-1 text-sm text-gray-600">New Password</label>
      </div>
      <div class="flex gap-2">
        <button type="button" class="text-gray-600 px-4 py-2">Cancel</button>
        <button type="submit" class="border border-gray-300 px-4 py-2 rounded">Update</button>
      </div>
    </form>
  </div>

  <button class="px-4 py-2 bg-yellow-500 text-white rounded flex items-center gap-2" style="width: 130px">
    <i class="pi pi-star-fill"></i>
    Favorites
  </button>
  <button class="px-4 py-2 bg-red-500 text-white rounded flex items-center gap-2" style="width: 130px">
    <i class="pi pi-sign-out"></i>
    Log Out
  </button>
</div>

<div class="hidden p-2 flex flex-col items-center gap-4 mb-1 bg-white rounded-lg shadow-lg">
  <p class="text-xl font-semibold text-orange-500">Favorites</p>
  <div class="p-2 flex flex-col items-center gap-4 mb-1">
    <div class="p-4 border border-gray-300 rounded">
      <i class="pi pi-bookmark-fill cursor-pointer" style="font-size: 1.5rem; color: #ffc107"></i>
      <p class="text-red-300 font-semibold">Favorite Post Title</p>
    </div>
    <p class="font-bold">¯\_(ツ)_/¯</p>
    <p>No Favorites</p>
  </div>
</div>
